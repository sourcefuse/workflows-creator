{
  "name": "@sourceloop/workflows-creator",
  "version": "1.1.9",
  "description": "Library for providing a smooth user workflow.",
  "keywords": [
    "angular-library"
  ],
  "peerDependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/elements": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "rxjs": "^7.8.0"
  },
  "scripts": {
    "checkIfNodeModulesExist": "[ -d \"../../node_modules\" ]",
    "installNodeModules": "cd ../../ && npm i",
    "prebuild": "npm run checkIfNodeModulesExist || npm run installNodeModules",
    "libraryBuild": "ng build workflows-creator && cp -r src/assets dist/assets",
    "elementBuild": "ng build workflows-element",
    "postbuild": "cd ../../ && tsx projects/workflows-creator/bundle-element.ts",
    "build": "npm run libraryBuild && npm run elementBuild",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "echo \"No tests available !\""
  },
  "devDependencies": {
    "@angular-eslint/schematics": "^22.8.0",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/elements": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@types/bpmn-moddle": "^5.1.6",
    "@types/fs-extra": "^11.0.1",
    "@types/lodash": "^4.14.182",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^8.0.3",
    "ng-packagr": "^22.2.6",
    "typescript": "~6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sourcefuse/workflows-creator.git"
  },
  "author": "Sourcefuse",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "directory": "dist"
  },
  "dependencies": {
    "@ng-select/ng-select": "^24.2.1",
    "bpmn-moddle": "^8.0.0",
    "camunda-bpmn-moddle": "^7.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "tslib": "^2.3.0"
  },
  "overrides": {
    "minimatch@>=10 <11": "^11.0.1",
    "glob@>=13 <14": "^14.0.2"
  }
}
