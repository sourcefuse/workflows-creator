{
  "name": "@sourceloop/workflows-creator",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sourcefuse/workflows-creator"
  },
  "author": "Sourcefuse",
  "license": "MIT",
  "private": false,
  "scripts": {
    "ng": "ng",
    "start": "npm --prefix workflow-sandbox start",
    "serve": "npm --prefix workflow-sandbox start",
    "ng:serve": "npm --prefix workflow-sandbox start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prettier:cli": "prettier \"**/*.ts\" \"**/*.js\" \"**/*.html\"",
    "prettier:check": "npm run prettier:cli -- --check",
    "prettier:fix": "npm run prettier:cli -- --write",
    "pretest": "npm run lint",
    "build:docs": "rm -rf ./docs && npx -y typedoc@^0.28.20 --out docs && cp projects/workflows-creator/README.md ./README.md",
    "workflowBuild": "ng build workflows-creator  && cp -r projects/workflows-creator/src/assets dist/workflows-creator/",
    "elementBuild": "ng build workflows-element && npx tsx projects/workflows-creator/bundle-element.ts",
    "test": "ng test --no-watch",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI --code-coverage",
    "lint": "ng lint",
    "prepare": "husky install",
    "clean-deps": "lerna clean --yes && lerna exec --no-private \"npm install --ignore-scripts --package-lock-only --no-audit\""
  },
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/elements": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ng-select/ng-select": "^24.2.1",
    "@popperjs/core": "^2.11.6",
    "@types/estree": "^1.0.0",
    "bpmn-moddle": "^8.0.0",
    "camunda-bpmn-moddle": "^7.0.0",
    "lerna": "^10.1.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "ng-multiselect-dropdown": "^0.3.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.8.0",
    "@angular-eslint/schematics": "^22.8.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@eslint/js": "^9.0.0",
    "@types/bpmn-moddle": "^5.1.11",
    "@types/fs-extra": "^11.0.4",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.14.182",
    "@types/node": "^22.0.0",
    "angular-eslint": "^22.8.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^6.9.2",
    "cz-customizable-ghooks": "^2.0.0",
    "eslint": "^9.0.0",
    "husky": "^8.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.6",
    "prettier": "^2.7.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "overrides": {
    "glob@>=13 <14": "^14.0.2",
    "tmp@^0.0.33": "^0.2.7",
    "nx": {
      "minimatch": "^11.0.1"
    },
    "@oxc-parser/binding-wasm32-wasi": {
      "@emnapi/core": "^1.7.1",
      "@emnapi/runtime": "^1.7.1"
    },
    "@npmcli/arborist": {
      "minimatch": "^11.0.1"
    },
    "@nx/devkit": {
      "minimatch": "^11.0.1"
    }
  }
}